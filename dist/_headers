# Browser caching. Pages and data keep Cloudflare's default (always re-check), so updates show right away.
# Styles and scripts are loaded with ?v= version numbers, so browsers can keep them for 30 days.
/styles.css
  Cache-Control: public, max-age=2592000
/app.js
  Cache-Control: public, max-age=2592000
/bounty-run.js
  Cache-Control: public, max-age=2592000
/drag-race.js
  Cache-Control: public, max-age=2592000
/crew.js
  Cache-Control: public, max-age=2592000
/log.js
  Cache-Control: public, max-age=2592000
/favicon-32.png
  Cache-Control: public, max-age=604800
/favicon-48.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/share-card-bebop.jpg
  Cache-Control: public, max-age=604800
/share/*
  Cache-Control: public, max-age=604800
/assets/*
  Cache-Control: public, max-age=604800
/banner.webp
  Cache-Control: public, max-age=604800
/banner-800.webp
  Cache-Control: public, max-age=604800
/avatar-280.jpg
  Cache-Control: public, max-age=604800
/avatar-420.jpg
  Cache-Control: public, max-age=604800
/sw.js
  Cache-Control: no-cache
/goal.js
  Cache-Control: public, max-age=2592000
/qr.js
  Cache-Control: public, max-age=2592000
/dashboard.js
  Cache-Control: public, max-age=2592000
# Private dashboard: never cached, never framed, never indexed
/dashboard/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer
/dashboard
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/dashboard/manifest.webmanifest
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

# Stream overlays for OBS: not for search engines
/overlay/*
  X-Robots-Tag: noindex, nofollow
